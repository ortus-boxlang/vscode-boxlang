{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://boxlang.io/schemas/miniserver.schema.json",
    "title": "BoxLang MiniServer Configuration",
    "description": "Project configuration for a BoxLang MiniServer.",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name for the MiniServer."
        },
        "host": {
            "type": "string",
            "default": "localhost",
            "description": "Host name used to access the MiniServer."
        },
        "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 8080,
            "description": "Port on which the MiniServer listens."
        },
        "directory": {
            "type": "string",
            "minLength": 1,
            "default": "./",
            "description": "Web root, absolute or relative to the workspace folder."
        },
        "type": {
            "type": "string",
            "enum": [
                "miniserver",
                "remote"
            ],
            "default": "miniserver",
            "description": "Server type."
        },
        "debugMode": {
            "type": "boolean",
            "default": false,
            "description": "Enable MiniServer debug mode."
        },
        "configFile": {
            "type": "string",
            "default": "",
            "description": "Optional BoxLang runtime configuration passed as --configPath."
        },
        "rewrites": {
            "type": "string",
            "description": "Optional MiniServer rewrite setting."
        }
    },
    "required": [
        "name",
        "host",
        "port",
        "directory",
        "type",
        "debugMode",
        "configFile"
    ],
    "additionalProperties": false
}
